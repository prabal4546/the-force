{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Band input event",
  "description": "HTTP body for POST /v1/band/events?device_id=...; independent of the older WebSocket WireMessage envelope.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": { "const": "adjust" },
        "delta": { "type": "number", "minimum": -1, "maximum": 1 }
      },
      "required": ["type", "delta"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "step" },
        "direction": { "type": "integer", "enum": [-1, 1] }
      },
      "required": ["type", "direction"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": { "type": { "const": "toggle" } },
      "required": ["type"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": { "type": { "const": "select" } },
      "required": ["type"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "command" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    }
  ]
}
