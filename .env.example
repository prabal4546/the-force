# Copy to .env. Do not commit .env.
# Use only the number printed on your own team's Vexo bag.
VEXO_BAND_NUMBER=

BODYOS_WS_HOST=0.0.0.0
BODYOS_WS_PORT=8765
BODYOS_SESSION_TOKEN=replace-with-a-random-demo-token

MENTRA_PHOTO_PORT=8787
EXTERNAL_DISPLAY_HINT=

BODYOS_API_HOST=127.0.0.1
BODYOS_API_PORT=8000
BODYOS_UPLOAD_DIR=.data/photos

# The API requires a Gemini key unless started with --simulate.
# Copy these to services/mac-runtime/.env or export them before make api.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
