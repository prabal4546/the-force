# Copy to .env and fill in. Never commit .env.

# ---- Where the screenshots go ----
# The team's device API (branch codex/api: `make api`, see docs/api.md there). Every screenshot is sent
# to POST /v1/glasses/photos. Empty = off (screenshots stay in data/ only).
# Use the API Mac's LAN address when it runs on another computer.
BODYOS_API_URL=
# Same value as the API's BODYOS_SESSION_TOKEN, if it has one. Never commit it.
BODYOS_SESSION_TOKEN=
# The glasses' device id in the API (registered as device_type "glasses"). glasses-1 matches docs/api.md.
BODYOS_DEVICE_ID=glasses-1
# Uploads sent at the same time (1-32). 4 keeps up with 30 screenshots a second.
BODYOS_PARALLEL=4

# Local copy of every screenshot (always written first).
DATA_DIR=./data

# ---- Fast screenshots: npm run frames ----
# Cut out of the glasses' live stream. 0 = every frame the glasses send (15-30 a second);
# a number = that many a second.
FRAMES_PER_SEC=0
# JPEG quality, 2 (best, biggest) to 31 (smallest). 4 is about 50-150 kB at 720p.
FRAME_QUALITY=4

# ---- SDK route (npm start), through the MentraOS app and ngrok ----
# From console.mentra.glass: the package name you chose and the app's API key.
PACKAGE_NAME=com.yourname.glassesrecorder
MENTRAOS_API_KEY=
# Local server port (the ngrok tunnel points at this).
PORT=3000

# 1 = the glasses stream to this Mac and `npm run frames` (run it too) turns the stream into screenshots.
# Photo commands are off while they stream (one camera, one job). Nothing of the stream is kept.
STREAM=0
# Leave empty to use rtmp://<this Mac's LAN address>:1935/live/glasses (what npm run frames listens on).
RTMP_URL=
STREAM_WIDTH=1280
STREAM_HEIGHT=720
# Frames per second = screenshots per second. If the glasses cannot do 30, try 15.
STREAM_FPS=30
STREAM_BITRATE=2000000

# With STREAM=0: one photo command every N seconds (0 = off). Each takes seconds over Bluetooth.
PHOTO_INTERVAL_SEC=10
PHOTO_SIZE=medium        # small | medium | large | full
PHOTO_COMPRESS=medium    # none | medium | heavy

# Optional: lets another program POST raw accel/gyro samples to /imu.
# Leave empty to keep /imu switched off. The tunnel is public: use a long random value.
INGEST_TOKEN=

# ---- Other ----
# Live feed for the Glasses Viewer app (on this computer only, never through ngrok). 0 = off.
LIVE_PORT=3001
# Wi-Fi photo receiver (npm run receive): port, and an optional token uploads must carry.
RECEIVER_PORT=8787
UPLOAD_TOKEN=
