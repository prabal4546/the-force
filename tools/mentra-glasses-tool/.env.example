# Copy to .env and fill in. Never commit .env.
# From console.mentra.glass: the package name you chose and the app's API key.
PACKAGE_NAME=com.yourname.glassesrecorder
MENTRAOS_API_KEY=

# Local server port (the ngrok tunnel points at this).
PORT=3000

# Where recordings go.
DATA_DIR=./data

# Screenshots: one photo every N seconds (0 = off). Each takes seconds over Bluetooth.
PHOTO_INTERVAL_SEC=10
PHOTO_SIZE=medium        # small | medium | large | full
PHOTO_COMPRESS=medium    # none | medium | heavy

# Video: 1 = glasses stream RTMP to this Mac (run `npm run video` first).
# Photos are turned off while video is on (one camera, one job at a time),
# and screenshots come from video frames instead.
VIDEO=0
# Leave empty to use rtmp://<this Mac's LAN address>:1935/live/glasses
RTMP_URL=
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=15
VIDEO_BITRATE=2000000

# Optional: lets another program POST raw accel/gyro samples to /imu.
# Leave empty to keep /imu switched off. The tunnel is public: use a long random value.
INGEST_TOKEN=

# Live feed for the Glasses Viewer app (on this computer only, never through ngrok). 0 = off.
LIVE_PORT=3001

# Wi-Fi receiver (npm run receive): port, and an optional token uploads must carry.
RECEIVER_PORT=8787
UPLOAD_TOKEN=

# Team BodyOS API (the Mac runtime's `make api`, see docs/api.md on the API branch).
# Set the URL and every photo and video clip is also kept there (the API needs POST /v1/glasses/videos for clips).
# Empty = off. Use the Mac's LAN address when the API runs on another computer.
BODYOS_API_URL=
# Same value as the API's BODYOS_SESSION_TOKEN, if it has one. Never commit it.
BODYOS_SESSION_TOKEN=
# The glasses' device id in the API (registered as device_type "glasses").
BODYOS_DEVICE_ID=mentra-live
